<config>
	<pages>
		<page>
			<prefix>
				fol.
			</prefix>
			<suffix>
				r
			</suffix>
		</page>
		<page>
			<prefix>
				fol.
			</prefix>
			<suffix>
				v
			</suffix>
		</page>
	</pages>
	<blocks>
		<block>
			<start_marker>
				[illustration]
			</start_marker>
			<type>
				STANDALONE
			</type>
		</block>
		<block>
			<start_marker>
				[legend]
			</start_marker>
			<has_text>
				true
			</has_text>
			<type>
				WITH_TEXT
			</type>
			<end_marker>
				---
			</end_marker>
		</block>
		<block>
			<start_marker>
				[margin]
			</start_marker>
			<has_text>
				true
			</has_text>
			<type>
				WITH_TEXT
			</type>
			<end_marker>
				---
			</end_marker>
		</block>
	</blocks>
	<words>
		<word>
			<label>
				Arabic
			</label>
			<char_range>
				600, 0x60FF
			</char_range>
			<additional_chars>
			</additional_chars>
			<default_state>
				sound
			</default_state>
		</word>
	</words>
	<prefixes>
		<prefix>
			<symbol>
				*
			</symbol>
			<label>
				emendation
			</label>
		</prefix>
		<prefix>
			<symbol>
				?
			</symbol>
			<label>
				unintelligible
			</label>
		</prefix>
		<prefix>
			<symbol>
				؟
			</symbol>
			<label>
				unintelligible
			</label>
		</prefix>
		<prefix>
			<symbol>
				!
			</symbol>
			<label>
				error
			</label>
		</prefix>
		<prefix>
			<symbol>
				†
			</symbol>
			<label>
				corrupt
			</label>
		</prefix>
	</prefixes>
	<brackets>
		<bracket>
			<open>
				(
			</open>
			<close>
				)
			</close>
			<label>
				title
			</label>
		</bracket>
		<bracket>
			<open>
				[
			</open>
			<close>
				]
			</close>
			<label>
				superfluous
			</label>
			<skip>
				true
			</skip>
		</bracket>
		<bracket>
			<precedence>
				0
			</precedence>
			<open>
				[[
			</open>
			<close>
				]]
			</close>
			<label>
				cross-out
			</label>
			<skip>
				true
			</skip>
		</bracket>
		<bracket>
			<open>
				{
			</open>
			<close>
				}
			</close>
			<label>
				suppletion
			</label>
		</bracket>
		<bracket>
			<open>
				&lt;
			</open>
			<close>
				&gt;
			</close>
			<label>
				added
			</label>
		</bracket>
	</brackets>
	<tags>
		<tag>
			<symbol>
				***
			</symbol>
			<label>
				lacuna
			</label>
		</tag>
		<tag>
			<symbol>
				...
			</symbol>
			<label>
				damage
			</label>
		</tag>
	</tags>
</config>
